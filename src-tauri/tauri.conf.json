{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Berth",
  "version": "0.1.0",
  "identifier": "app.berth.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "泊岸 · Berth",
        "width": 320,
        "height": 680,
        "minWidth": 280,
        "minHeight": 400,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) 2026 Berth contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": { "minimumSystemVersion": "12.0", "infoPlist": "Info.plist" },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
